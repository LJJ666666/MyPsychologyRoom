# LLM 对话模式 — mock 或 api
# mock：使用内置的模拟回复，无需外部依赖，适合开发和演示
# api：调用真实的 LLM API（OpenAI 兼容格式）
VITE_LLM_MODE=mock

# === API 模式专用（VITE_LLM_MODE=api 时使用）===

# LLM API 入口
# 默认为 '/api/v1/chat/completions'（通过 Vite 代理转发到 localhost:3000）
# 也可直接填写完整 URL，如 'https://api.openai.com/v1/chat/completions'
VITE_LLM_API_URL=/api/v1/chat/completions

# LLM API Key（如果需要）
VITE_LLM_API_KEY=

# 模型名称
VITE_LLM_MODEL=gpt-4o-mini
